{
  "name": "bulk-record-upload",
  "private": true,
  "version": "1.0.0",
  "description": "Configuration-driven bulk CSV upload application for Salesforce",
  "files": [
    "force-app/",
    "examples/",
    "manifest/package.xml",
    "config/project-scratch-def.json",
    "scripts/check-apex.mjs",
    "scripts/check-docs.mjs",
    "scripts/check-metadata.mjs",
    "scripts/check-package-boundary.mjs",
    "scripts/check-release-boundary.mjs",
    "scripts/check-demo-assets.mjs",
    "scripts/generate-demo-assets.mjs",
    "scripts/list-apex-tests.mjs",
    "scripts/run-large-schema-benchmark.mjs",
    "scripts/apex/schedule-maintenance.apex",
    "scripts/apex/seed-demo-data.apex",
    "scripts/apex/unschedule-maintenance.apex",
    "scripts/apex/verify-account-demo.apex",
    "scripts/apex/verify-demo-configuration.apex",
    "scripts/apex/verify-process-keys.apex",
    "docs/admin/",
    "docs/developer/",
    "docs/examples/",
    "docs/get-started/",
    "docs/reference/",
    "docs/user/",
    "docs/README.md",
    "docs/project-status.md",
    "docs/roadmap.md",
    ".forceignore",
    ".gitattributes",
    ".prettierignore",
    ".prettierrc",
    "code-analyzer.yml",
    "eslint.config.js",
    "jest-sa11y-setup.js",
    "jest.config.js",
    "sfdx-project.json",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "NOTICE.md",
    "RELEASING.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "scripts": {
    "lint": "eslint force-app/main/default/{aura,lwc}/**/*.js scripts/**/*.mjs",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "check:package-boundary": "node scripts/check-package-boundary.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check:apex": "node scripts/check-apex.mjs",
    "check:demo-assets": "node scripts/check-demo-assets.mjs",
    "check:source": "npm run check:package-boundary && npm run check:metadata && npm run check:apex && npm run check:demo-assets",
    "benchmark:large-schema": "node scripts/run-large-schema-benchmark.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:release-boundary": "node scripts/check-release-boundary.mjs",
    "check:all": "npm run lint && npm run prettier:verify && npm run test:unit && npm run check:source && npm run check:docs && npm run check:release-boundary && npm run benchmark:large-schema",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@sa11y/jest": "^8.0.28",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
