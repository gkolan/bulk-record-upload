<?xml version="1.0" encoding="utf-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Operation__c</fullName>
  <description
  >Selects the approved record operation performed by this upload process.</description>
  <inlineHelpText
  >Choose Insert, Update, Upsert, or Delete. Delete requires separate delete access.</inlineHelpText>
  <label>Upload Operation</label>
  <required>true</required>
  <type>Picklist</type>
  <valueSet>
    <restricted>true</restricted>
    <valueSetDefinition>
      <sorted>false</sorted>
      <value>
        <fullName>INSERT</fullName>
        <default>true</default>
        <label>Insert</label>
      </value>
      <value>
        <fullName>UPDATE</fullName>
        <default>false</default>
        <label>Update</label>
      </value>
      <value>
        <fullName>UPSERT</fullName>
        <default>false</default>
        <label>Upsert</label>
      </value>
      <value>
        <fullName>DELETE</fullName>
        <default>false</default>
        <label>Delete</label>
      </value>
    </valueSetDefinition>
  </valueSet>
</CustomField>
