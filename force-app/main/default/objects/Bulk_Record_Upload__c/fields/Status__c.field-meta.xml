<?xml version="1.0" encoding="utf-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Status__c</fullName>
  <description
  >Stores the stable version 1 upload lifecycle value used by runtime orchestration and administrator history.</description>
  <inlineHelpText
  >Review the current upload state. Statuses move forward from Queued to one terminal result.</inlineHelpText>
  <label>Upload Status</label>
  <required>true</required>
  <type>Picklist</type>
  <valueSet>
    <restricted>true</restricted>
    <valueSetDefinition>
      <sorted>false</sorted>
      <value>
        <fullName>QUEUED</fullName>
        <default>true</default>
        <label>Queued</label>
      </value>
      <value>
        <fullName>VALIDATING</fullName>
        <default>false</default>
        <label>Validating</label>
      </value>
      <value>
        <fullName>PROCESSING</fullName>
        <default>false</default>
        <label>Processing</label>
      </value>
      <value>
        <fullName>COMPLETED</fullName>
        <default>false</default>
        <label>Completed</label>
      </value>
      <value>
        <fullName>COMPLETED_WITH_ERRORS</fullName>
        <default>false</default>
        <label>Completed With Errors</label>
      </value>
      <value>
        <fullName>FAILED</fullName>
        <default>false</default>
        <label>Failed</label>
      </value>
    </valueSetDefinition>
  </valueSet>
</CustomField>
